{% extends 'base.html.twig' %}

{% block title %}Gestion des Congés{% endblock %}

{% block body %}
<div class="container mt-4">

    {# ==========================================
       AFFICHAGE POUR LES ADMINISTRATEURS (RH)
       ========================================== #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Administration des Congés</h1>
                <p class="text-muted mb-0">Gestion globale des demandes de congés de tous les agents</p>
            </div>
            <a href="{{ path('app_conge_new') }}" class="btn btn-primary">Déposer un congé</a>
        </div>

        {# Zone de messages Flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} shadow-sm">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-0">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Agent</th>
                            <th>Type</th>
                            <th>Date de début</th>
                            <th>Date de fin</th>
                            <th>Demandé le</th>
                            <th>Statut / Décision</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for conge in conges %}
                        <tr>
                            {# Vérification de l'existence du demandeur lié au congé #}
                            <td>
                                {% if conge.demandeur is not null %}
                                    <strong>{{ conge.demandeur.nom|upper }}</strong> {{ conge.demandeur.prenom }}
                                    <br><small class="text-muted">{{ conge.demandeur.email }}</small>
                                {% else %}
                                    <span class="text-muted font-italic">Agent inconnu</span>
                                {% endif %}
                            </td>
                            {# Vérification sécurisée du type de congé #}
                            <td>
                                {% if conge.type is not null and conge.type.nom is defined %}
                                    {% set typeNom = conge.type.nom|lower %}
                                    {% if 'payé' in typeNom %}
                                        <span class="badge bg-primary text-white">{{ conge.type.nom }}</span>
                                    {% elseif 'rtt' in typeNom %}
                                        <span class="badge bg-info text-dark">{{ conge.type.nom }}</span>
                                    {% elseif 'maladie' in typeNom or 'sans solde' in typeNom %}
                                        <span class="badge bg-secondary text-white">{{ conge.type.nom }}</span>
                                    {% else %}
                                        <span class="badge bg-dark text-white">{{ conge.type.nom }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge bg-light text-dark">Non spécifié</span>
                                {% endif %}
                            </td>
                            <td>{{ conge.dateDebut ? conge.dateDebut|date('d/m/Y') : '' }}</td>
                            <td>{{ conge.dateFin ? conge.dateFin|date('d/m/Y') : '' }}</td>
                            <td>{{ conge.dateDemande ? conge.dateDemande|date('d/m/Y') : '' }}</td>
                            <td>
                                {% if conge.decision == 'En attente' %}
                                    <span class="badge bg-warning text-dark">En attente</span>
                                {% elseif conge.decision == 'Accepté' %}
                                    <span class="badge bg-success">Accepté</span>
                                {% else %}
                                    <span class="badge bg-danger">Refusé</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a href="{{ path('app_conge_show', {'id': conge.id}) }}" class="btn btn-outline-info">Voir</a>
                                    <a href="{{ path('app_conge_edit', {'id': conge.id}) }}" class="btn btn-outline-warning">Traiter</a>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Aucune demande de congé trouvée.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    {# ==========================================
       AFFICHAGE POUR LES AGENTS STANDARDS (USER)
       ========================================== #}
    {% else %}
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1>Mon historique de congés</h1>
                <p class="text-muted mb-0">Suivi et état de vos demandes personnelles</p>
            </div>
            <a href="{{ path('app_conge_new') }}" class="btn btn-primary">Déposer un congé</a>
        </div>

        {# Zone de messages Flash #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }} shadow-sm">
                    {{ message }}
                </div>
            {% endfor %}
        {% endfor %}

        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-0">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Type</th>
                            <th>Date de début</th>
                            <th>Date de fin</th>
                            <th>Date de demande</th>
                            <th>Statut / Décision</th>
                            <th>Commentaire RH</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for conge in conges %}
                        <tr>
                            {# Vérification sécurisée du type de congé #}
                            <td>
                                {% if conge.type is not null and conge.type.nom is defined %}
                                    {% set typeNom = conge.type.nom|lower %}
                                    {% if 'payé' in typeNom %}
                                        <span class="badge bg-primary text-white">{{ conge.type.nom }}</span>
                                    {% elseif 'rtt' in typeNom %}
                                        <span class="badge bg-info text-dark">{{ conge.type.nom }}</span>
                                    {% elseif 'maladie' in typeNom or 'sans solde' in typeNom %}
                                        <span class="badge bg-secondary text-white">{{ conge.type.nom }}</span>
                                    {% else %}
                                        <span class="badge bg-dark text-white">{{ conge.type.nom }}</span>
                                    {% endif %}
                                {% else %}
                                    <span class="badge bg-light text-dark">Non spécifié</span>
                                {% endif %}
                            </td>
                            <td>{{ conge.dateDebut ? conge.dateDebut|date('d/m/Y') : '' }}</td>
                            <td>{{ conge.dateFin ? conge.dateFin|date('d/m/Y') : '' }}</td>
                            <td>{{ conge.dateDemande ? conge.dateDemande|date('d/m/Y') : '' }}</td>
                            <td>
                                {% if conge.decision == 'En attente' %}
                                    <span class="badge bg-warning text-dark">En attente</span>
                                {% elseif conge.decision == 'Accepté' %}
                                    <span class="badge bg-success">Accepté</span>
                                {% else %}
                                    <span class="badge bg-danger">Refusé</span>
                                {% endif %}
                            </td>
                            <td>
                                <small class="text-muted font-italic">{{ conge.commentaire ?: 'Aucun commentaire' }}</small>
                            </td>
                            <td class="text-end">
                                <a href="{{ path('app_conge_show', {'id': conge.id}) }}" class="btn btn-sm btn-outline-info">Détails</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">
                                Vous n'avez pas encore déposé de demande de congé.
                            </td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    <div class="mt-4">
        <a href="{{ path('app_home') }}" class="btn btn-secondary">Retour à l'accueil</a>
    </div>
</div>
{% endblock %}