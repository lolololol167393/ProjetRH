{% extends 'base.html.twig' %}

{% block title %}Conge{% endblock %}

{% block body %}
    <h1>Conge</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ conge.id }}</td>
            </tr>
            <tr>
                <th>Date_debut</th>
                <td>{{ conge.dateDebut ? conge.dateDebut|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date_fin</th>
                <td>{{ conge.dateFin ? conge.dateFin|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date_reponse</th>
                <td>{{ conge.dateReponse ? conge.dateReponse|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Date_demande</th>
                <td>{{ conge.dateDemande ? conge.dateDemande|date('Y-m-d') : '' }}</td>
            </tr>
            <tr>
                <th>Commentaire</th>
                <td>{{ conge.commentaire }}</td>
            </tr>
            <tr>
                <th>Commentaire_demandeur</th>
                <td>{{ conge.commentaireDemandeur }}</td>
            </tr>
            <tr>
                <th>Decision</th>
                <td>{{ conge.decision }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_conge_index') }}">back to list</a>

    <a href="{{ path('app_conge_edit', {'id': conge.id}) }}">edit</a>

    {{ include('conge/_delete_form.html.twig') }}
{% endblock %}
