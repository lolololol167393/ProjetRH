{% extends 'base.html.twig' %}

{% block title %}Liste des Rôles{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Liste des Rôles</h1>
        <a href="{{ path('app_role_new') }}" class="btn btn-primary">Créer un nouveau rôle</a>
    </div>

    {# Affichage des messages flash s'il y en a #}
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'success' ? 'success' : 'danger' }}">
                {{ message }}
            </div>
        {% endfor %}
    {% endfor %}

    <table class="table table-striped table-hover align-middle shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Droit / Permissions</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for role in roles %}
            <tr>
                <td>{{ role.id }}</td>
                <td><strong>{{ role.nom }}</strong></td>
                <td>
                    <span class="badge bg-secondary text-white">
                        {{ role.droit }}
                    </span>
                </td>
                <td class="text-end">
                    <a href="{{ path('app_role_show', {'id': role.id}) }}" class="btn btn-sm btn-outline-info">Voir</a>
                    <a href="{{ path('app_role_edit', {'id': role.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4" class="text-center py-4 text-muted">
                    Aucun rôle enregistré pour le moment.
                </td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="mt-4">
        <a href="{{ path('app_home') }}" class="btn btn-secondary">Retour à l'accueil</a>
    </div>
</div>
{% endblock %}