{% extends 'base.html.twig' %}

{% block title %}Mon Espace RH{% endblock %}

{% block body %}
<div class="row mb-4">
    <div class="col-12">
        <h1 class="h3 mb-3">Tableau de bord de <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong></h1>
        <p class="text-muted">Bienvenue dans votre espace personnel de gestion des congés.</p>
    </div>
</div>

<div class="row g-3 mb-5">
    {# Bloc des indicateurs pour l'ADMINISTRATEUR #}
    {% if is_granted('ROLE_ADMIN') %}
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Congés globaux</h6>
                    <h2 class="display-6 fw-bold">RH</h2>
                    <small>Vue d'ensemble de la structure</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Demandes à traiter</h6>
                    <h2 class="display-6 fw-bold">À réviser</h2>
                    <small>Consulter la liste générale</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Planning équipe</h6>
                    <h2 class="display-6 fw-bold">Actif</h2>
                    <small>Visualisation globale</small>
                </div>
            </div>
        </div>
    {# Bloc des indicateurs pour l'AGENT STANDARD #}
    {% else %}
        <div class="col-md-4">
            <div class="card bg-primary text-white shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Congés restants</h6>
                    <h2 class="display-6 fw-bold">-</h2>
                    <small>Acquis pour l'année en cours</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-warning text-dark shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">En attente de validation</h6>
                    <h2 class="display-6 fw-bold">-</h2>
                    <small>Demandes envoyées au manager</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white shadow-sm">
                <div class="card-body">
                    <h6 class="card-title">Prochains congés</h6>
                    <h2 class="display-6 fw-bold">-</h2>
                    <small>Consulter vos validations</small>
                </div>
            </div>
        </div>
    {% endif %}
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white fw-bold">Actions rapides</div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="{{ path('app_conge_new') }}" class="btn btn-outline-primary btn-lg py-3">
                        <i class="bi bi-plus-circle"></i> Déposer une demande
                    </a>
                    <a href="{{ path('app_user_profile') }}" class="btn btn-outline-secondary">
                        Consulter mon profil
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-white d-flex justify-content-between align-items-center">
                <span class="fw-bold">
                    {% if is_granted('ROLE_ADMIN') %}
                        Les dernières demandes de l'organisation
                    {% else %}
                        Mes dernières demandes
                    {% endif %}
                </span>
                <a href="{{ path('app_conge_index') }}" class="btn btn-sm btn-link">Voir tout</a>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            {% if is_granted('ROLE_ADMIN') %}
                                <th>Agent</th>
                            {% endif %}
                            <th>Type</th>
                            <th>Dates</th>
                            <th>Statut</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for conge in conges %}
                            <tr>
                                {# Affichage du nom de l'agent si connecté en tant qu'admin #}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <td>
                                        <strong>{{ conge.demandeur ? conge.demandeur.nom|upper : 'Inconnu' }}</strong> 
                                        {{ conge.demandeur ? conge.demandeur.prenom : '' }}
                                    </td>
                                {% endif %}

                                {# Type de congé dynamique avec gestion des badges de couleur #}
                                <td>
                                    {% if conge.type is not null %}
                                        {% set typeNom = conge.type.nom|lower %}
                                        {% if 'payé' in typeNom %}
                                            <span class="badge bg-primary text-white">{{ conge.type.nom }}</span>
                                        {% elseif 'rtt' in typeNom %}
                                            <span class="badge bg-info text-dark">{{ conge.type.nom }}</span>
                                        {% elseif 'maladie' in typeNom or 'sans solde' in typeNom %}
                                            <span class="badge bg-secondary text-white">{{ conge.type.nom }}</span>
                                        {% else %}
                                            <span class="badge bg-dark text-white">{{ conge.type.nom }}</span>
                                        {% endif %}
                                    {% else %}
                                        <span class="badge bg-light text-dark">Non spécifié</span>
                                    {% endif %}
                                </td>

                                {# Dates de début et fin de la demande #}
                                <td>
                                    Du {{ conge.dateDebut ? conge.dateDebut|date('d/m/Y') : '' }} 
                                    au {{ conge.dateFin ? conge.dateFin|date('d/m/Y') : '' }}
                                </td>

                                {# Statut / Décision dynamique #}
                                <td>
                                    {% if conge.decision == 'En attente' %}
                                        <span class="badge rounded-pill bg-warning text-dark">En attente</span>
                                    {% elseif conge.decision == 'Accepté' %}
                                        <span class="badge rounded-pill bg-success">Accepté</span>
                                    {% else %}
                                        <span class="badge rounded-pill bg-danger">Refusé</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    Aucune demande de congé enregistrée pour le moment.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}