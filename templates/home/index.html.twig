{# templates/home/user_index.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Accueil - Projet RH{% endblock %}

{% block body %}
<div class="container mt-5">
    <div class="p-5 mb-4 bg-light rounded-3 text-center shadow-sm">
        <div class="container-fluid py-5">
            <h1 class="display-5 fw-bold text-primary">Bienvenue sur WorkTogether<h1 class="h3 mb-3">Tableau de bord de <strong>{{ app.user.prenom }} {{ app.user.nom }}</strong></h1></h1>
        </div>
    </div>

    {% if app.user %}
        <div class="card shadow">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <h3 class="card-title mb-0 h5"><i class="bi bi-calendar-check me-2"></i>Mes Demandes de Congés</h3>
                <a href="{{ path('app_conge_new') }}" class="btn btn-light btn-sm fw-bold">Nouvelle demande</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover mb-0 align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th class="ps-3">Type</th>
                                <th>Date de début</th>
                                <th>Date de fin</th>
                                <th class="pe-3">Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                        {% for conge in conges %}
                            <tr>
                                <td class="ps-3 fw-semibold">{{ conge.type.nom }}</td>
                                <td>{{ conge.dateDebut ? conge.dateDebut|date('d/m/Y') : '' }}</td>
                                <td>{{ conge.dateFin ? conge.dateFin|date('d/m/Y') : '' }}</td>
                                <td class="pe-3">
                                    {% if conge.decision == 'En attente' %}
                                        <span class="badge bg-warning text-dark px-3 py-2">En attente</span>
                                    {% elseif conge.decision == 'Accepté' %}
                                        <span class="badge bg-success px-3 py-2">Accepté</span>
                                    {% else %}
                                        <span class="badge bg-danger px-3 py-2">Refusé</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    <i class="bi bi-info-circle me-1"></i> Vous n'avez pas encore soumis de demande de congé.
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            {% if conges|length > 0 %}
                <div class="card-footer bg-white text-end py-3">
                    <a href="{{ path('app_conge_index') }}" class="btn btn-outline-primary btn-sm">Voir tout l'historique</a>
                </div>
            {% endif %}
        </div>
    {% else %}
        <div class="alert alert-warning text-center shadow-sm py-4" role="alert">
            <h4 class="alert-heading fw-bold mb-3">Accès restreint</h4>
            <p class="mb-3">Veuillez vous authentifier pour accéder à votre espace personnel et voir vos congés.</p>
            <a href="{{ path('app_login') }}" class="btn btn-primary px-4 fw-bold">Se connecter</a>
        </div>
    {% endif %}
</div>
{% endblock %}